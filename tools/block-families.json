{
  "sets": {
    "color": ["white", "orange", "magenta", "light_blue", "yellow", "lime", "pink", "gray", "light_gray", "cyan", "purple", "blue", "brown", "green", "red", "black"],
    "wood": ["oak", "spruce", "birch", "acacia", "cherry", "jungle", "dark_oak", "pale_oak", "crimson", "warped", "mangrove", "bamboo"],
    "wax": ["", "waxed_"],
    "copper": [
      { "block": "", "texture": "copper" },
      { "block": "exposed_", "texture": "copper_exposed" },
      { "block": "weathered_", "texture": "copper_weathered" },
      { "block": "oxidized_", "texture": "copper_oxidized" }
    ],
    "skull": [
      { "floor": "skeleton_skull", "wall": "skeleton_wall_skull", "model": "skeleton_skull" },
      { "floor": "wither_skeleton_skull", "wall": "wither_skeleton_wall_skull", "model": "wither_skeleton_skull" },
      { "floor": "zombie_head", "wall": "zombie_wall_head", "model": "zombie_head" },
      { "floor": "creeper_head", "wall": "creeper_wall_head", "model": "creeper_head" },
      { "floor": "dragon_head", "wall": "dragon_wall_head", "model": "dragon_skull" },
      { "floor": "piglin_head", "wall": "piglin_wall_head", "model": "piglin_head" },
      { "floor": "player_head", "wall": "player_wall_head", "model": "player_head" }
    ]
  },
  "rotations": {
    "facing": { "property": "facing", "degrees": { "south": 0, "west": 270, "north": 180, "east": 90 } },
    "segment": { "property": "rotation", "step": -22.5 },
    "wallSkull": { "property": "facing", "degrees": { "north": 0, "east": 270, "south": 180, "west": 90 } }
  },
  "families": [
    {
      "note": "ChestRenderer: YP(-FACING.toYRot()) about the block centre; Sheets.chooseMaterial entity/chest/normal[_left|_right]",
      "block": "chest",
      "parts": [
        { "model": "chest", "texture": "chest/normal", "when": { "type": "single" } },
        { "model": "double_chest_left", "texture": "chest/normal_left", "when": { "type": "left" } },
        { "model": "double_chest_right", "texture": "chest/normal_right", "when": { "type": "right" } }
      ],
      "rotation": "facing"
    },
    {
      "note": "ChestRenderer.getChestMaterial TrappedChestBlockEntity: entity/chest/trapped[_left|_right]",
      "block": "trapped_chest",
      "parts": [
        { "model": "chest", "texture": "chest/trapped", "when": { "type": "single" } },
        { "model": "double_chest_left", "texture": "chest/trapped_left", "when": { "type": "left" } },
        { "model": "double_chest_right", "texture": "chest/trapped_right", "when": { "type": "right" } }
      ],
      "rotation": "facing"
    },
    {
      "note": "ChestRenderer.getChestMaterial EnderChestBlockEntity: entity/chest/ender; no TYPE property, always the single model",
      "block": "ender_chest",
      "parts": [{ "model": "chest", "texture": "chest/ender" }],
      "rotation": "facing"
    },
    {
      "note": "ChestRenderer.getChestMaterial CopperChestBlock.getState(): entity/chest/copper[_exposed|_weathered|_oxidized][_left|_right]; waxed blocks share the WeatherState",
      "each": ["wax", "copper"],
      "block": "{wax}{copper.block}copper_chest",
      "parts": [
        { "model": "chest", "texture": "chest/{copper.texture}", "when": { "type": "single" } },
        { "model": "double_chest_left", "texture": "chest/{copper.texture}_left", "when": { "type": "left" } },
        { "model": "double_chest_right", "texture": "chest/{copper.texture}_right", "when": { "type": "right" } }
      ],
      "rotation": "facing"
    },
    {
      "note": "ShulkerBoxRenderer: Sheets.DEFAULT_SHULKER_TEXTURE_LOCATION entity/shulker/shulker; FACING uses Direction.getRotation(), not a Y rotation, so only the facing=up pose is described",
      "block": "shulker_box",
      "parts": [{ "model": "shulker_box", "texture": "shulker/shulker" }]
    },
    {
      "note": "ShulkerBoxRenderer: Sheets.getShulkerBoxMaterial entity/shulker/shulker_<color>; rotation as shulker_box",
      "each": ["color"],
      "block": "{color}_shulker_box",
      "parts": [{ "model": "shulker_box", "texture": "shulker/shulker_{color}" }]
    },
    {
      "note": "BedRenderer: model by PART, Sheets.getBedMaterial entity/bed/<color>; ZP(180 + FACING.toYRot()) after XP(90) equals YP(-toYRot) about the block centre on top of the constant 180",
      "each": ["color"],
      "block": "{color}_bed",
      "parts": [
        { "model": "bed_head", "texture": "bed/{color}", "when": { "part": "head" } },
        { "model": "bed_foot", "texture": "bed/{color}", "when": { "part": "foot" } }
      ],
      "rotation": "facing"
    },
    {
      "note": "SkullBlockRenderer: model by SkullBlock.Type, SKIN_BY_TYPE is each model's default texture; head yRot = ROTATION * 22.5 under scale(-1,-1,1) equals YP(-22.5 * ROTATION)",
      "each": ["skull"],
      "block": "{skull.floor}",
      "parts": [{ "model": "{skull.model}" }],
      "rotation": "segment"
    },
    {
      "note": "SkullBlockRenderer: WallSkullBlock uses the segment of FACING.getOpposite() and translate(0.5 - stepX/4, 0.25, 0.5 - stepZ/4) instead of (0.5, 0, 0.5)",
      "each": ["skull"],
      "block": "{skull.wall}",
      "parts": [{ "model": "{skull.model}" }],
      "rotation": "wallSkull",
      "translation": [0, 4, 4]
    },
    {
      "note": "SignRenderer.translateSign: YP(-StandingSignBlock.getYRotationDegrees) about the block centre; model and texture per WoodType",
      "each": ["wood"],
      "block": "{wood}_sign",
      "parts": [{ "model": "sign/standing/{wood}" }],
      "rotation": "segment"
    },
    {
      "note": "SignRenderer.translateSign: YP(-WallSignBlock FACING.toYRot()); the wall offset follows the rotation and is constant for the wall model",
      "each": ["wood"],
      "block": "{wood}_wall_sign",
      "parts": [{ "model": "sign/wall/{wood}" }],
      "rotation": "facing"
    },
    {
      "note": "HangingSignRenderer: AttachmentType.byBlockState CeilingHangingSignBlock ATTACHED ? ceiling_middle : ceiling; YP(-ROTATION * 22.5)",
      "each": ["wood"],
      "block": "{wood}_hanging_sign",
      "parts": [
        { "model": "hanging_sign/{wood}/ceiling", "when": { "attached": "false" } },
        { "model": "hanging_sign/{wood}/ceiling_middle", "when": { "attached": "true" } }
      ],
      "rotation": "segment"
    },
    {
      "note": "HangingSignRenderer: wall attachment model; YP(-WallHangingSignBlock FACING.toYRot())",
      "each": ["wood"],
      "block": "{wood}_wall_hanging_sign",
      "parts": [{ "model": "hanging_sign/{wood}/wall" }],
      "rotation": "facing"
    },
    {
      "note": "BannerRenderer: standing model and flag layer, angle = -ROTATION * 22.5; the base colour is a tint of entity/banner_base, not a texture",
      "each": ["color"],
      "block": "{color}_banner",
      "parts": [{ "model": "standing_banner" }, { "model": "standing_banner", "layer": "flag" }],
      "rotation": "segment"
    },
    {
      "note": "BannerRenderer: wall model and flag layer, angle = -WallBannerBlock FACING.toYRot()",
      "each": ["color"],
      "block": "{color}_wall_banner",
      "parts": [{ "model": "wall_banner" }, { "model": "wall_banner", "layer": "flag" }],
      "rotation": "facing"
    },
    {
      "note": "BellRenderer: bell body only, no state-dependent pose (frame and attachment come from the block model)",
      "block": "bell",
      "parts": [{ "model": "bell" }]
    },
    {
      "note": "ConduitRenderer: an inactive conduit draws only the shell with SHELL_TEXTURE entity/conduit/base at the block centre",
      "block": "conduit",
      "parts": [{ "model": "conduit", "layer": "shell" }]
    },
    {
      "note": "DecoratedPotRenderer: base and sides with Sheets.DECORATED_POT_BASE/SIDE; YP(180 - HORIZONTAL_FACING.toYRot()) about the block centre",
      "block": "decorated_pot",
      "parts": [{ "model": "decorated_pot_base" }, { "model": "decorated_pot_sides" }],
      "rotation": "facing"
    }
  ]
}
